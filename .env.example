# ==============================================================================
# Resume Builder — Environment Configuration
# Copy to .env.local and fill in your credentials
# ==============================================================================

# OpenAI-Compatible AI Gateway / Inference Endpoint (DeepSeek, OpenAI, Cloudflare Workers AI, etc.)
AI_GATEWAY_URL="https://api.openai.com/v1"
AI_GATEWAY_KEY="your-api-key-here"
AI_MODEL="gpt-4o-mini"

# Optional: Local Ollama Server (used when selecting Local Ollama provider or fallback)
OLLAMA_HOST="http://localhost:11434"

# Root Administrator Credentials (for /admin user management console)
ROOT_ADMIN_USERNAME="admin@resumepipeline.com"
# Set either a plaintext password (hashed at startup) or a pre-computed scrypt hash:
ROOT_ADMIN_PASSWORD="change-me-on-setup"
# ROOT_ADMIN_PASSWORD_HASH="salt:scrypt_hex_hash"
